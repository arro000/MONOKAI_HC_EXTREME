{
  "name": "monokai-hc-extreme",
  "displayName": "Monokai HC extreme",
  "description": "Monokai syntax highlighting with a GitHub-inspired high-contrast interface, in dark and light variants",
  "repository": "https://github.com/arro000/MONOKAI_HC_EXTREME",
  "publisher": "Zibro",
  "icon": "images/icon.png",
  "version": "1.4.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "keywords": [
    "light",
    "dark",
    "theme",
    "color-theme",
    "monokai",
    "high-contrast",
    "github",
    "csharp",
    "typescript",
    "vue",
    "angular",
    "go",
    "rust",
    "swift",
    "bash",
    "react",
    "jsx",
    "tsx"
  ],
  "categories": [
    "Themes"
  ],
  "scripts": {
    "check": "node scripts/check-themes.cjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "jsonc-parser": "3.3.1"
  },
  "contributes": {
    "themes": [
      {
        "label": "Monokai HC extreme dark",
        "uiTheme": "hc-black",
        "path": "./themes/monkai-high-contrast-extreme-dark-color-theme.json"
      },
      {
        "label": "Monokai HC extreme light",
        "uiTheme": "hc-light",
        "path": "./themes/monkai-high-contrast-extreme-light-color-theme.json"
      }
    ]
  }
}
